# Local development environment for the Kanban plugin.
# This file is a sample only: it is not read by the plugin at runtime and it is
# excluded from the release archive (see .gitattributes).
#
# ---------------------------------------------------------------------------
# 1. Docker stacks (docker-compose.glpi10.yml / docker-compose.glpi11.yml)
# ---------------------------------------------------------------------------
# Usage:
#   .\test-plugin.ps1                # GLPI 10 (port 8090) + GLPI 11 (port 8091)
#   .\test-plugin.ps1 -Versions 10   # only GLPI 10
#   .\test-plugin.ps1 -Tests         # also run the PHPUnit suite
#   .\test-plugin.ps1 -Down          # tear down the stacks
#
# URLs:
#   GLPI 10 -> http://localhost:8090/plugins/kanban/front/kanban.php
#   GLPI 11 -> http://localhost:8091/plugins/kanban/front/kanban.php
#
# Default login (both): glpi / glpi
#
# Credentials below are throw-away local values already used as defaults in
# those compose files; keep them in sync if you change them.

GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=glpi_password
GLPI_DB_ROOT_PASSWORD=root_password

# ---------------------------------------------------------------------------
# 2. E2E seeders (tests/e2e/seeder.php, tests/e2e/seed_browser.php,
#    create_test_tickets.php)
# ---------------------------------------------------------------------------
# The seeders read credentials from the environment ONLY - there is no default
# and no fallback, so a copy of these files can never write to a database with
# hard-coded credentials. They abort when a variable is missing and refuse to
# run outside the CLI (PHP_SAPI !== 'cli' => HTTP 403).
#
#   KANBAN_DB_HOST   MariaDB host as seen from the CLI (use 127.0.0.1 with the
#                    published port, or `docker compose exec` inside the network)
#   KANBAN_DB_USER   database user
#   KANBAN_DB_PASS   database password
#   KANBAN_DB_NAME   database name
#   KANBAN_TEST_PASS password given to the accounts created by the seeder
#   KANBAN_CLEANUP   set to 1 to only remove a previously seeded scenario
#   KANBAN_URL       board URL used by create_test_tickets.php for its output

KANBAN_DB_HOST=127.0.0.1
KANBAN_DB_USER=glpi
KANBAN_DB_PASS=glpi_password
KANBAN_DB_NAME=glpi
KANBAN_TEST_PASS=kanban-test
KANBAN_URL=http://localhost:8090/plugins/kanban/front/kanban.php
