# GLPI Docker test environment (official glpi/glpi images)
#
# Usage:
#   .\test-plugin.ps1                # GLPI 10 (port 8090) + GLPI 11 (port 8091)
#   .\test-plugin.ps1 -Versions 10   # only GLPI 10
#   .\test-plugin.ps1 -Tests         # also run the PHPUnit suite
#   .\test-plugin.ps1 -Down          # tear down the stacks
#
# URLs:
#   GLPI 10 -> http://localhost:8090/plugins/kanban/front/kanban.php
#   GLPI 11 -> http://localhost:8091/plugins/kanban/front/kanban.php
#
# Default login (both): glpi / glpi
#
# Database settings used by docker-compose.glpi10.yml and docker-compose.glpi11.yml.
# These values are already the defaults in those files; keep in sync if you change them.

GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=glpi_password
GLPI_DB_ROOT_PASSWORD=root_password
