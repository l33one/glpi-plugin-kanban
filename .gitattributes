# Development-only files: kept in the repository for review and CI, but never
# shipped in the release archive. `git archive` (tools/build-release.sh) honours
# `export-ignore`, so the published tarball contains only the plugin runtime.

/tests/                          export-ignore
/tools/                          export-ignore
/docker/                         export-ignore
/dist/                           export-ignore
/.github/                        export-ignore
/.env.example                    export-ignore
/.gitattributes                  export-ignore
/.gitignore                      export-ignore
/create_test_tickets.php         export-ignore
/docker-compose.yml              export-ignore
/docker-compose.glpi10.yml       export-ignore
/docker-compose.glpi11.yml       export-ignore
/test-plugin.ps1                 export-ignore
/phpunit.xml.dist                export-ignore
/prompt.md                       export-ignore
/PLAN-*.md                   export-ignore

# Binary assets are never rewritten by the export filter.
/kanban.png       binary

# Keep the catalogues LF everywhere: they are text formats compared line by
# line, and core.autocrlf would otherwise rewrite them on Windows.
/locales/*.po    text eol=lf
